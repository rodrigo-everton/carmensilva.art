NEXT_PUBLIC_SITE_URL=https://www.carmemsilva.art.br

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Token server-only com permissão Editor, usado apenas para reservar/vender obras.
SANITY_API_WRITE_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Credenciais privadas do Resend. Nunca use NEXT_PUBLIC_ nestas variáveis.
RESEND_SECRET_KEY=
RESEND_FROM_EMAIL=no-reply@updates.carmemsilva.art.br
RESEND_FROM_NAME="Carmem Silva"

# Credenciais privadas do Checkout Pro. Nunca use NEXT_PUBLIC_ nestas chaves.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_SELLER_ID=
MERCADOPAGO_SITE_ID=MLB
MERCADOPAGO_PREFERENCE_TTL_HOURS=24
# Segredo aleatório (mínimo 16 caracteres) usado somente pelo Vercel Cron.
CRON_SECRET=

# Identificadores opcionais; o Checkout Pro atual não usa OAuth.
MERCADOPAGO_APPLICATION_ID=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
